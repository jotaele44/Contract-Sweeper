          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /contracts",
          "GET /entities",
          "GET /edges",
          "GET /municipalities",
          "GET /stats"
        ]
      },
      "frontend": {
        "routes": [
          "/"
        ],
        "e2e_routes": [
          "/"
        ],
        "components": [
          "dashboard/src/lib/api.js",
