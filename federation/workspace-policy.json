{
  "schema_version": "prii_workspace_policy_v1",
  "program_id": "moneysweep-pr",
  "canonical_python": "3.11",
  "local_environment": ".venv",
  "environment_scope": "repository_private",
  "allow_shared_federation_environment": false,
  "allow_system_install_local": false,
  "workspace_role": "producer",
