{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "moneysweep_entity.schema.json",
  "title": "moneysweep-pr Entity",
  "description": "A canonical entity row (funding agency, recipient, sub-recipient, etc.).",
  "type": "object",
  "required": [
    "entity_id",
    "source_id",
    "name",
    "normalized_name",
    "entity_type",
    "jurisdiction",
    "confidence",
    "lineage",
    "synthetic",
    "created_at",
    "extracted_at"
  ],
  "properties": {
    "entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{32}$"},
    "source_id": {"type": "string", "pattern": "^src_[a-f0-9]{32}$"},
    "name": {"type": "string"},
    "normalized_name": {"type": "string"},
    "entity_type": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "external_ids": {
      "type": "object",
      "description": "Optional external identifiers for cross-repo entity matching by the spiderweb-pr query hub.",
      "properties": {
        "uei": {"type": "string"},
        "parent_uei": {"type": "string"}
      }
    },
    "location": {
      "type": "object",
      "description": "Optional location, mirroring thehub-pr's federation_entity.schema.json. This producer emits the municipality form only: it resolves municipalities but carries no coordinates, and manufacturing a centroid here would duplicate the spatial producer's authority. A consumer reads attribution_source/attribution_confidence to tell this apart from a surveyed point.",
      "anyOf": [
        {"required": ["lat", "lon"]},
        {"required": ["municipality"]}
      ],
      "properties": {
        "lat": {"type": "number", "minimum": -90.0, "maximum": 90.0},
        "lon": {"type": "number", "minimum": -180.0, "maximum": 180.0},
        "municipality": {"type": "string"},
        "attribution_source": {"type": "string"},
        "attribution_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "lineage": {"$ref": "#/definitions/lineage"},
    "synthetic": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "extracted_at": {"type": "string", "format": "date-time"}
  },
  "definitions": {
    "lineage": {
      "type": "object",
      "required": ["producer_script", "producer_phase", "source_inputs"],
      "properties": {
        "producer_script": {"type": "string"},
        "producer_phase": {"type": "string"},
        "source_inputs": {"type": "array", "items": {"type": "string"}},
        "extraction_method": {"type": "string"}
      }
    }
  }
}
