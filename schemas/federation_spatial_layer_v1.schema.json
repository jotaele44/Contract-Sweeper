{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://federation.local/schemas/federation_spatial_layer_v1.schema.json",
  "title":"Federation Spatial Layer v1","type":"object","additionalProperties":false,
  "required":["contract_version","layer_id","layer_version","producer_repo","domain","title","geometry_types","crs","feature_count","source_authority","logical_sha256","source_manifestation_sha256","refresh_policy","coordinate_method","coordinate_confidence","access_class","sensitivity_class","identity_semantics","status","certification_state"],
  "properties":{"contract_version":{"const":"federation-spatial-contract/1.0"},"layer_id":{"type":"string"},"layer_version":{"type":"string"},"producer_repo":{"enum":["spiderweb-pr","moneysweep-pr","aguayluz-pr","skywatcher-pr"]},"domain":{"type":"string"},"title":{"type":"string"},"geometry_types":{"type":"array","items":{"enum":["Point","MultiPoint","LineString","MultiLineString","Polygon","MultiPolygon","Raster","Trajectory4D"]},"uniqueItems":true},"crs":{"type":"string"},"bbox":{"type":["array","null"],"items":{"type":"number"}},"feature_count":{"type":"integer","minimum":0},"temporal_extent":{"type":["object","null"]},"source_authority":{"type":"string"},"source_url":{"type":["string","null"]},"license":{"type":["string","null"]},"logical_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source_manifestation_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"refresh_policy":{"enum":["STATIC","ON_CHANGE","HOURLY","DAILY","WEEKLY","MONTHLY","ANNUAL","MANUAL"]},"last_refresh":{"type":["string","null"]},"coordinate_method":{"type":"string"},"coordinate_confidence":{"enum":["HIGH","MEDIUM","LOW","UNKNOWN"]},"access_class":{"enum":["PUBLIC","AUTHENTICATED","RESTRICTED","ADMIN"]},"sensitivity_class":{"enum":["PUBLIC","INTERNAL","SENSITIVE","RESTRICTED"]},"identity_semantics":{"enum":["CANDIDATE_NOT_IDENTITY","IDENTITY_BINDING","NOT_APPLICABLE"]},"status":{"enum":["DONE","PARTIAL","BLOCKED","OPEN","DEPRECATED"]},"certification_state":{"enum":["OPEN","TESTED","CERTIFIED","BLOCKED"]}}
}