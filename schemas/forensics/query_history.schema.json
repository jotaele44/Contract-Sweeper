{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-forensics.local/schemas/query_history.schema.json",
  "title": "Query History",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id"
  ],
  "properties": {
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        null
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "superseded_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "review_status": {
      "enum": [
        "UNREVIEWED",
        "MACHINE_VALIDATED",
        "HUMAN_REVIEWED",
        "CONTRADICTED",
        "SUPERSEDED",
        "REJECTED",
        null
      ]
    },
    "supersedes_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "query_key": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  }
}