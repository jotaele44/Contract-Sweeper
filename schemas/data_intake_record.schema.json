{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data_intake_record.schema.json",
  "title": "Data Intake Record",
  "description": "Core intake object tracking a single acquired source record across NP_LAYER, FIN_AUDIT, INF_CTRL, and shared domains.",
  "type": "object",
  "required": [
    "intake_id",
    "received_at",
    "source_type",
    "source_name",
    "jurisdiction",
    "domain",
    "record_type",
    "acquisition_method",
    "access_class",
    "hash_sha256",
    "parser_status",
    "provenance_status",
    "evidence_tier",
    "contains_pii",
    "publication_eligible"
  ],
  "properties": {
    "intake_id": {"type": "string", "minLength": 1},
    "received_at": {"type": "string", "format": "date-time"},
    "source_type": {"type": "string", "enum": ["pdf", "csv", "web", "filing", "registry", "court_docket", "api", "archive", "other"]},
    "source_name": {"type": "string", "minLength": 1},
    "source_url": {"type": ["string", "null"]},
    "local_file_path": {"type": ["string", "null"]},
    "jurisdiction": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "enum": ["np_layer", "fin_audit", "inf_ctrl", "shared"]},
    "record_type": {"type": "string", "minLength": 1},
    "reporting_period_start": {"type": ["string", "null"], "format": "date"},
    "reporting_period_end": {"type": ["string", "null"], "format": "date"},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "acquisition_method": {"type": "string", "enum": ["download", "api", "scrape", "manual_export", "records_request", "archive"]},
    "access_class": {"type": "string", "enum": ["public", "restricted_public", "internal"]},
    "hash_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser_status": {"type": "string", "enum": ["pending", "parsed", "partial", "failed", "unsupported"]},
    "provenance_status": {"type": "string", "enum": ["verified", "derivative", "unverified"]},
    "evidence_tier": {"type": "string", "enum": ["T1", "T2", "T3", "T4"]},
    "contains_pii": {"type": "boolean"},
    "publication_eligible": {"type": "boolean"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
