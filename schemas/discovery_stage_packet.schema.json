{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moneysweep-pr.local/schemas/discovery_stage_packet.schema.json",
  "title": "DiscoveryStagePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "created_at",
    "subject_seeds",
    "candidates",
    "relationships",
    "contradictions",
    "explicit_exclusions",
    "source_manifest"
  ],
  "properties": {
    "schema_version": {"const": "discovery_stage_packet_v1"},
    "case_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "subject_seeds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "entity_type",
          "raw_names",
          "normalized_names",
          "identifiers",
          "identity_state",
          "certification_state",
          "evidence_refs",
          "canonical_candidate",
          "addresses"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "entity_type": {"type": "string", "minLength": 1},
          "raw_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "normalized_names": {"type": "array", "items": {"type": "string"}},
          "canonical_candidate": {"type": ["string", "null"]},
          "addresses": {"type": "array", "items": {"type": "string"}},
          "identifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value",
                "valid_from",
                "valid_to",
                "source_date",
                "issuer",
                "source_record_id"
              ],
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "value": {"type": "string", "minLength": 1},
                "valid_from": {"type": ["string", "null"]},
                "valid_to": {"type": ["string", "null"]},
                "source_date": {"type": ["string", "null"]},
                "issuer": {"type": ["string", "null"]},
                "source_record_id": {"type": ["string", "null"]}
              }
            }
          },
          "identity_state": {
            "enum": ["CONFIRMED", "PROBABLE", "CANDIDATE", "REJECTED", "UNRESOLVED"]
          },
          "certification_state": {
            "enum": [
              "PASS",
              "FAIL",
              "OPEN",
              "BLOCKED",
              "PROVISIONAL",
              "AUDIT_ONLY",
              "NONCANONICAL",
              "CANDIDATE_NOT_IDENTITY",
              "UNRESOLVED",
              "SUPERSEDED"
            ]
          },
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left_candidate_id",
          "predicate",
          "right_candidate_id",
          "cardinality",
          "evidence_refs",
          "valid_from",
          "valid_to"
        ],
        "properties": {
          "left_candidate_id": {"type": "string"},
          "predicate": {"type": "string"},
          "right_candidate_id": {"type": "string"},
          "cardinality": {"enum": ["1:1", "1:N", "N:1", "N:N", "0:1", "UNRESOLVED"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "valid_from": {"type": ["string", "null"]},
          "valid_to": {"type": ["string", "null"]}
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "candidate_ids", "evidence_refs", "state", "note"],
        "properties": {
          "kind": {"enum": ["BYTE", "SCHEMA", "GEOMETRY", "NAME", "COUNT", "CLASS", "IDENTITY", "TIME", "SCOPE"]},
          "candidate_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "state": {"type": "string"},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "explicit_exclusions": {"type": "array", "items": {"type": "string"}},
    "source_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_ref",
          "source_id",
          "retrieved_at",
          "source_record_id",
          "url",
          "sha256",
          "assertion_type"
        ],
        "properties": {
          "evidence_ref": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "source_record_id": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "assertion_type": {"enum": ["explicit", "derived", "inferred"]}
        }
      }
    }
  }
}