{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoneySweep Capital and Control Holding Observation",
  "description": "Temporal source observation. Reported legal holder, investor family, and ultimate parent are separate identity levels; normalization is not identity proof.",
  "type": "object",
  "required": [
    "observation_id",
    "issuer_id",
    "issuer_name",
    "security_id",
    "holder_legal_entity_id",
    "holder_reported_name_raw",
    "as_of_date",
    "report_date",
    "position_class",
    "relation_type",
    "identity_status",
    "source_id",
    "source_document_id"
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "issuer_name": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "security_name": {"type": "string"},
    "holder_legal_entity_id": {"type": "string", "minLength": 1},
    "holder_reported_name_raw": {"type": "string", "minLength": 1},
    "investor_family_id": {"type": "string"},
    "investor_family_name": {"type": "string"},
    "ultimate_parent_id": {"type": "string"},
    "ultimate_parent_name": {"type": "string"},
    "as_of_date": {"type": "string", "format": "date"},
    "report_date": {"type": "string", "format": "date"},
    "shares": {"type": ["number", "null"], "minimum": 0},
    "market_value": {"type": ["number", "null"], "minimum": 0},
    "percent_class": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "percent_issuer": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "voting_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "sole_voting_power": {"type": ["number", "null"], "minimum": 0},
    "shared_voting_power": {"type": ["number", "null"], "minimum": 0},
    "sole_dispositive_power": {"type": ["number", "null"], "minimum": 0},
    "shared_dispositive_power": {"type": ["number", "null"], "minimum": 0},
    "position_class": {
      "type": "string",
      "enum": [
        "BENEFICIAL_OWNER",
        "INVESTMENT_ADVISER",
        "FUND",
        "NOMINEE",
        "CUSTODIAN",
        "TRUSTEE",
        "PENSION",
        "INSIDER",
        "CORPORATE_PARENT",
        "GOVERNMENT",
        "SOVEREIGN_FUND",
        "UNKNOWN"
      ]
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "BENEFICIAL_OWNERSHIP",
        "INVESTMENT_DISCRETION",
        "VOTING_AUTHORITY",
        "DISPOSITIVE_AUTHORITY",
        "DIRECT_EQUITY",
        "INDIRECT_EQUITY",
        "FUND_HOLDING",
        "NOMINEE",
        "CUSTODY",
        "TRUST",
        "INSIDER",
        "PARENT_CONTROL",
        "DEBT",
        "LENDING",
        "BONDHOLDING",
        "GUARANTEE",
        "LIEN",
        "MORTGAGE",
        "COLLATERAL",
        "JV_INTEREST",
        "PRIVATE_EQUITY_SPONSORSHIP",
        "UNKNOWN"
      ]
    },
    "identity_status": {
      "type": "string",
      "enum": ["CERTIFIED", "PROVISIONAL", "CANDIDATE_NOT_IDENTITY", "UNRESOLVED"]
    },
    "source_id": {"type": "string", "minLength": 1},
    "source_document_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string"},
    "retrieval_utc": {"type": "string"},
    "source_period": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "amendment_sequence": {"type": "integer", "minimum": 0},
    "supersedes_observation_id": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
