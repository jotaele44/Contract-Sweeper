{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://federation.local/schemas/federation_spatial_manifest_v1.schema.json",
  "title":"Federation Spatial Sidecar Manifest v1","type":"object","additionalProperties":false,
  "required":["contract_version","producer_repo","authority","frozen_base_sha","branch","contracts","storage","domain_extensions","cross_repo","gates"],
  "properties":{"contract_version":{"const":"federation-spatial-manifest/1.0"},"producer_repo":{"enum":["spiderweb-pr","moneysweep-pr","aguayluz-pr","skywatcher-pr"]},"authority":{"type":"string","minLength":1},"frozen_base_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"branch":{"type":"string"},"contracts":{"type":"object","required":["feature","layer","map_runtime","offline_package","impact_report"],"additionalProperties":{"type":"string"}},"storage":{"type":"object","required":["postgis_migration","mvt_migration","ownership"],"properties":{"postgis_migration":{"type":"string"},"mvt_migration":{"type":"string"},"ownership":{"const":"REPO_LOCAL"}}},"domain_extensions":{"type":"array","items":{"type":"string"}},"cross_repo":{"type":"object","required":["identity_default","hub_correlation_authority","consumer_contract"],"properties":{"identity_default":{"const":"CANDIDATE_NOT_IDENTITY"},"hub_correlation_authority":{"const":"thehub-pr"},"consumer_contract":{"type":"string"}}},"gates":{"type":"object","additionalProperties":{"enum":["PASS","OPEN","BLOCKED","N/A"]}}}
}